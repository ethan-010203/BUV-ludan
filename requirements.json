        },
        {
          "title": "法人代表信息",
          "fields": [
            { "key": "上传法人代表证件信息",           "source": "idcard_or_passport" },
            { "key": "法人代表身份证（人像面）",       "source": "file_path",       "fileKey": "id_card_front" },
            { "key": "法人代表身份证（国徽面）",       "source": "file_path",       "fileKey": "id_card_back" },
            { "key": "法人/个人代表中文名",            "source": "ai_idcard_front", "aiField": "姓名" },
            { "key": "法人/个人代表身份证号",          "source": "ai_idcard_front", "aiField": "身份证号" },
            { "key": "法人/个人代表拼音名（英文名）",  "source": "ai_idcard_front", "aiField": "拼音名" },
            { "key": "法人/个人代表出生日期",          "source": "ai_idcard_front", "aiField": "出生日期" },
            { "key": "法人代表身份证有效期限",         "source": "ai_idcard_back",  "aiField": "有效期限" },
            { "key": "法人/个人代表身份证地址",        "source": "ai_idcard_front", "aiField": "住址" },
            { "key": "法人/个人代表身份证邮编",        "source": "postal_from_idcard_address" },
            { "key": "性别",                           "source": "ai_idcard_front", "aiField": "性别" },
            { "key": "法人国籍",                       "source": "default",         "value": "中国籍" }
          ]
        },
        {
          "title": "店铺信息",
          "fields": [
            { "key": "销售平台",                          "source": "default", "value": "" },
            { "key": "店铺链接",                          "source": "xlsx",    "cell": "C14" },
            { "key": "公司（个人）店铺主要经营范围",      "source": "default", "value": "电子商品 electrical products" },
            { "key": "公司英文名称",                      "source": "xlsx",    "cell": "C4" },
            { "key": "公司/个体经营注册地址（英文）",     "source": "xlsx",    "cell": "C6" },
            { "key": "联系邮箱",                          "source": "xlsx",    "cell": "C20" }
          ]
        }
