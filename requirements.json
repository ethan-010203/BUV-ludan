  "requirements": {
    "Poland|China": {
      "label": "波兰 - 中国大陆注册",

      "addressLocale": "zh-CN",
      "autofillModule": "poland_seller_center",
      "xlsxTemplate": "basic_info_v1",
      "aiDocTypes": [
        "cn_business_license",
        "cn_id_card_front",
        "cn_id_card_back",
        "cn_tax_cert"
      ],

      "fields": [
        { "key": "id_card_front", "label": "身份证正面", "required": true },
        { "key": "id_card_back", "label": "身份证反面", "required": true },
        { "key": "business_license", "label": "营业执照", "required": true },
        { "key": "tax_certificate", "label": "完税证明", "required": true },
        { "key": "shop_backend_screenshot", "label": "店铺后台截图", "required": true },
        { "key": "basic_info", "label": "基础信息表", "required": true }
      ],

      "files": [
        { "key": "id_card_front", "pattern": "身份证正面", "label": "身份证正面", "required": true, "matchType": "contains" },
        { "key": "id_card_back", "pattern": "身份证反面", "label": "身份证反面", "required": true, "matchType": "contains" },
        { "key": "business_license", "pattern": "营业执照", "label": "营业执照", "required": true, "matchType": "contains", "showInAutofill": true, "autofillStatusLabel": "营业执照文件", "convertImageToPdf": true },
        { "key": "tax_certificate", "pattern": "完税证明", "label": "完税证明", "required": true, "matchType": "contains", "showInAutofill": true, "autofillStatusLabel": "中国税收居民身份证明", "convertImageToPdf": true },
        { "key": "shop_backend_screenshot", "pattern": "店铺后台截图", "label": "店铺后台截图", "required": true, "matchType": "contains", "allowedExtensions": [".jpg", ".jpeg", ".png"], "showInAutofill": true, "convertImageToPdf": false },
        { "key": "basic_info", "pattern": ".xlsx", "label": "基础信息表", "required": true, "matchType": "endsWith", "xlsxA1Contains": "新注册申请登记表" }
      ],

      "placeholders": {
        "tax_certificate":         { "kind": "pdf", "filename": "完税证明_临时占位.pdf",     "text": "完税证明（临时占位）" },
        "shop_backend_screenshot": { "kind": "png", "filename": "店铺后台截图_临时占位.png", "text": "店铺后台截图（临时占位）" }
      },

      "modules": [
        {
          "title": "公司信息",
          "fields": [
            { "key": "公司名称",                       "source": "xlsx",       "cell": "C3" },
